{
    "name": "privofit/app",
    "description": "PRIVOFIT – soukromé samoobslužné fitness studio",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "giggsey/libphonenumber-for-php": "^8.13",
        "phpmailer/phpmailer": "^6.9",
        "spomky-labs/otphp": "^11.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "install-app": "php bin/install.php",
        "cron": "php bin/cron.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
