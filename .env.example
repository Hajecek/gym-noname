# =============================================================================
# PRIVOFIT – konfigurace prostředí
# Zkopírujte tento soubor jako .env a vyplňte skutečné hodnoty.
# Soubor .env nesmí být veřejně přístupný.
# =============================================================================

APP_NAME=PRIVOFIT
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/gym-noname
APP_KEY=
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Europe/Prague
APP_LOCALE=cs-CZ
APP_CURRENCY=CZK

# Produkce na Wedos: nastavte APP_ENV=production a APP_DEBUG=false
# a vygenerujte APP_KEY pomocí: php bin/install.php --generate-key

# Document root je kořen projektu (index.php). Citlivé složky jsou zakázané v .htaccess.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=privofit
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_NAME=privofit_session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
REMEMBER_ME_DAYS=30

MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@privofit.cz
MAIL_FROM_NAME="PRIVOFIT"

# Have I Been Pwned k-anonymity (odesílá se pouze prefix SHA-1, nikoli heslo)
HIBP_ENABLED=true

# Vstupní systém. mock = testovací režim, nuki = ostrá integrace po ověření zařízení.
DOOR_PROVIDER=mock
NUKI_API_BASE=https://api.nuki.io
NUKI_API_TOKEN=
NUKI_SMARTLOCK_ID=
NUKI_ACTION=unlatch
NUKI_TIMEOUT=15

# Platební brána – připraveno, aktivace až po výběru poskytovatele.
PAYMENT_PROVIDER=manual

# Cron token pro volání bin/cron.php přes HTTPS (Wedos plánovač)
CRON_TOKEN=

# Instalace: po vytvoření OWNER účtu se instalační endpoint deaktivuje.
INSTALL_ENABLED=true
